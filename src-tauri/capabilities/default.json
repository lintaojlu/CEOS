{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-append-agent-log",
    "allow-append-model-log",
    "allow-agent-store",
    "allow-llm-http",
    "allow-idea-store",
    "allow-user-records"
  ]
}
